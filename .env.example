# =============================================================
#  Old Document Digitizer — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit the actual .env file to Git.
# =============================================================

# ── Ollama (LLM) ──────────────────────────────────────────────
# Host where Ollama is running. Default: http://127.0.0.1:11434
# Keep Ollama on localhost only. Do NOT expose port 11434 publicly.
OLLAMA_HOST=http://127.0.0.1:11434

# Model to use (must be pulled with `ollama pull <model>`)
OLLAMA_MODEL=qwen2.5:7b

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins for production.
# Leave blank to allow all (development mode only).
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=

# ── Flask ─────────────────────────────────────────────────────
# Set to "production" in production. Disables dev-only test routes.
FLASK_ENV=development
